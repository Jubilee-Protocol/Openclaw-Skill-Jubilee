# RPC Providers
# ⚠️  Public RPCs are rate-limited and may fail under heavy use.
# For reliable operation, use a free dedicated RPC:
#   Alchemy: https://www.alchemy.com/ (free tier: 300M compute units/mo)
#   Infura: https://www.infura.io/ (free tier: 100K requests/day)
#   QuickNode: https://www.quicknode.com/ (free tier available)
RPC_BASE=https://mainnet.base.org
RPC_BASE_SEPOLIA=https://sepolia.base.org
RPC_ETHEREUM=https://eth.llamarpc.com
RPC_SOLANA=https://api.mainnet-beta.solana.com

# Protocol Addresses (Optional - defaults to official mainnet)
# These are pre-configured in config.js

# Wallet (Managed by OpenClaw)
# Ensure ~/.openclaw/workspace/setup_wallet_dir_new/wallets/agent_wallet.json exists
WALLET_PATH=/path/to/custom/wallet.json

# Solana Wallet (for Jupiter swaps)
# Supports standard Solana CLI format (~/.config/solana/id.json) or OpenClaw format
SOLANA_WALLET_PATH=/path/to/solana_wallet.json

# Default chain for operations
DEFAULT_CHAIN=base

# Debug mode (verbose logging)
DEBUG=false

# 0x Swap API Key (optional but recommended - increases rate limits)
# Get yours at: https://0x.org/docs/introduction/getting-started
ZERO_EX_API_KEY=your_0x_api_key_here

# Jupiter API Key (required for Solana swaps via Jupiter)
# Get a free key at: https://portal.jup.ag
JUPITER_API_KEY=your_jupiter_api_key_here

# Lightning Network (optional - for Bitcoin payments)
# Requires a running LND node. See: https://github.com/lightninglabs/lightning-agent-tools
LND_REST_HOST=https://localhost:8080
LND_MACAROON_PATH=~/.lnd/data/chain/bitcoin/mainnet/admin.macaroon
LND_TLS_CERT_PATH=~/.lnd/tls.cert
